{
  "name": "rpg-mundo-aberto",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/server.js",
    "test": "node --test tests/knowledge/*.test.mjs",
    "knowledge:validate": "node scripts/knowledge/cli.mjs validate",
    "knowledge:query": "node scripts/knowledge/cli.mjs query",
    "knowledge:impact": "node scripts/knowledge/cli.mjs impact",
    "knowledge:baseline": "node scripts/knowledge/cli.mjs baseline",
    "knowledge:adr": "node scripts/knowledge/cli.mjs adr",
    "graphify:setup": "node scripts/knowledge/graphify.mjs setup",
    "graphify:refresh": "node scripts/knowledge/graphify.mjs refresh",
    "graphify:status": "node scripts/knowledge/graphify.mjs status",
    "graphify:query": "node scripts/knowledge/graphify.mjs query",
    "check": "npm run test && npm run knowledge:validate && npm run build"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "ajv": "8.20.0",
    "typescript": "^4.9.5",
    "yaml": "2.9.1"
  }
}
